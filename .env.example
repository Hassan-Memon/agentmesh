# ---------------------------------------------------------------------------
# AgentMesh environment. Copy to .env and adjust. Never commit a real .env.
# Every value below has a working default for `docker compose up` with no keys.
# ---------------------------------------------------------------------------

# Stub LLM, stub embeddings, no external calls. Set to 0 to use a real model.
DEMO_MODE=1

# LLM provider selection (used when DEMO_MODE=0). One of:
#   openinfer | ollama | groq | gemini | openrouter
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
# OpenAI-compatible base URL for OpenInfer (product 2) or any compatible server.
OPENINFER_BASE_URL=
OPENINFER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Embeddings: stub (deterministic hash), openai-compatible (uses OPENINFER_BASE_URL), or sentence-transformers.
EMBEDDINGS_PROVIDER=stub

# Postgres (pgvector image). LangGraph checkpoints, semantic memory, and gateway run records.
DATABASE_URL=postgresql://agentmesh:agentmesh@localhost:5432/agentmesh

# Event bus. amqp:// for RabbitMQ, kafka:// for Redpanda/Kafka, memory:// for single process.
BUS_URL=amqp://agentmesh:agentmesh@localhost:5672/
RABBITMQ_URL=amqp://agentmesh:agentmesh@localhost:5672/

# Optional: event log in MongoDB. Leave empty to store events in Postgres JSONB.
MONGO_URL=

# Optional: Redis (rate limiting / socket adapter later).
REDIS_URL=redis://localhost:6379

# Agent runtime gRPC endpoint (host:port) that the gateway dials.
AGENT_RUNTIME_GRPC_URL=localhost:50051
AGENT_RUNTIME_GRPC_PORT=50051

# Gateway
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Dashboard (public values are embedded in the browser bundle)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
